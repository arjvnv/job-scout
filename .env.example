ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
USAJOBS_USER_AGENT=your_email@example.com
USAJOBS_AUTH_KEY=your_usajobs_api_key_here

# Optional: enable AI chat (--chat) and resume scoring (--resume).
# Configure exactly one provider key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: default resume path used by --chat when --resume is not passed.
RESUME_PATH=
